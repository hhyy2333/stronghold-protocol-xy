{
  // First typecheck slice (npm run typecheck). strict stays off until a folder is clean.
  // tsc does not load this file unless invoked with -p jsconfig.json.
  // Widen one path at a time: see types/README.md.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": [],
    "lib": ["ES2022"],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "shared/**/*.js",
    "server/sim/rng.js",
    "server/sim/detmath.js",
    "server/sim/dir.js",
    "server/sim/constants.js",
    "types/**/*.js"
  ],
  "exclude": [
    "shared/protocol.js",
    "shared/bandBonds.js",
    // Forge 独有的 8 个文件：它们落在 `shared/**` 里，所以被 include 扫到，但从来不属于上游那份「已经能过
    // tsc 的封闭集合」。报错全是这一批（没有 node 类型导致 Buffer/process 认不出，外加几处联合返回值的
    // JSDoc 推断），与玩法无关；等这个切片按 types/README.md 的规矩扩到它们时再逐个修。
    "shared/zip.js",
    "shared/workshop.js",
    "shared/chessAuthoring.js",
    "shared/support.js",
    "shared/enemyAuthoring.js",
    "shared/statReference.js",
    "shared/stageAuthoring.js",
    "shared/waveAuthoring.js",
    // 同一条理由再补两个：它们也落在 `shared/**` 里、也被 `include` 扫到，但 JSDoc 与代码的形状对不上（不是
    // 代码错，是注释只标了一半）。各报 2 / 4 条，与玩法无关：
    //   * formProjection.js —— `@template T` 是裸泛型，`rec.chessId` / `rec.id` / `rec.baseId` 在类型层面
    //     「不存在」，运行期当然存在；
    //   * morph.js —— `MORPH_PAIRING_OPTIONS.includes(decl)` 推断出 `boolean`，返回类型却是字面量联合
    //     `'official'|'plus'`，于是 `decl` / `hit.option`（`string`）赋不过去。
    // 两处都没有测试覆盖，改之前先自己跑一遍（见 types/README.md 的「校验方式」）。
    "shared/formProjection.js",
    "shared/morph.js"
  ]
}
