{
  "id": "originium-exchange",
  "name": "源石证券交易所",
  "version": "1.2.2",
  "author": "hhyy2333",
  "license": "CC0-1.0",
  "description": "在每一局的休整期开一家源石证券交易所：六支「盟约概念股」跟着本局各盟约的冷热与随机新闻涨跌，3~8 块一股，用对局资金买卖、按股吃分红，可加 2x / 3x 杠杆（借钱、计息 12%、爆仓），结算时比总资产。纯工坊包，不改引擎一行代码。",
  "api": "1.x",
  "combat": true,
  "server": {
    "modules": [
      {
        "id": "exchange",
        "entry": "server/exchange.mjs",
        "uses": ["matchClass"],
        "channels": ["trade"]
      }
    ]
  },
  "client": {
    "panels": [
      {
        "id": "exchange",
        "slot": "screen.game.aside",
        "module": "ui/exchange.js",
        "styles": ["ui/exchange.css"],
        "messages": ["trade", "market"],
        "order": 10
      }
    ]
  }
}
