,"effect":{"bondShare":true}},"hex_layershift":{"id":"hex_layershift","name":"层数转移","desc":"战斗开始时，你层数最低的已激活盟约把一半层数转移给层数最高的已激活盟约。","rarity":"silver","effect":{"onBattleStart":{"layerTransfer":true}}},"hex_pyrrhic":{"id":"hex_pyrrhic","name":"因小失大","desc":"本局中，附加盟约（调和与独行除外）的激活条件减少 1 名干员，核心盟约的激活条件增加 1 名干员。","rarity":"gold","effect":{"onPick":{"bondCountShift":{"small":1,"big":-1}}}},"hex_deepdevour":{"id":"hex_deepdevour","name":"深度吞噬","desc":"〖阿戈尔〗干员吞噬时，其攻击目标数 +1。","rarity":"gold","effect":{"devourTarget":{"maxTargets":1}}},"hex_indomember":{"id":"hex_indomember","name":"不屈余烬","desc":"〖不屈〗盟约效果触发后，该干员获得 6 秒阻挡数 +2。","rarity":"silver","effect":{"indomEmber":{"seconds":6,"block":2}}},"hex_traitspread":{"id":"hex_traitspread","name":"特质扩散","desc":"战斗开始时，你最靠左（同列更靠下）的干员把自身的战斗特质复制给相邻一格的干员（优先右边）。","rarity":"gold","effect":{"traitSpread":true}},"hex_killgift":{"id":"hex_killgift","name":"击倒馈赠","desc":"作战中，你的干员每击倒 1 个敌人，该干员攻击力 +10%（本场战斗内叠加）。","rarity":"silver","effect":{"killGift":{"atkPct":10}}},"hex_skillflow":{"id":"hex_skillflow","name":"技能层涌","desc":"作战中，你的干员每次开启技能时，其所属的已激活盟约层数 +1（单场战斗中每个盟约最多通过此效果叠加 40 层）。","rarity":"silver","effect":{"skillFlow":{"layers":1,"maxLayersPerBond":40}}},"hex_eliteresonance":{"id":"hex_eliteresonance","name":"精英共鸣","desc":"场上每有 1 名精锐干员（数量 x），你购买干员时有 5x% 概率直接获得其精锐形态。","rarity":"gold","effect":{"onBuy":{"eliteBuy":{"pctPerElite":5}}}},"hex_bountytriple":{"id":"hex_bountytriple","name":"悬赏倍增","desc":"本局中，你获得的悬赏资金 ×3。","rarity":"gold","effect":{"bountyMul":3}},"hex_shopcontract":{"id":"hex_shopcontract","name":"商店契约","desc":"获得时立即得到 3 次免费刷新；每次刷新后你购买的第一名干员价格 −1（最低 0 费）。","rarity":"gold","effect":{"onPick":{"freeRefresh":3},"onRefresh":{"shopContractArm":true},"onPrice":{"shopContractDiscount":1},"onBuy":{"shopContractSpend":true}}},"hex_itemrefund":{"id":"hex_itemrefund","name":"装备转化","desc":"你弃置装备时，返还其购买价格。","rarity":"silver","effect":{"onDestroy":{"itemRefund":true}}},"hex_fullkit":{"id":"hex_fullkit","name":"整装待发","desc":"干员可装备 3 个装备（装备变形同构体与两个阵营装