+// docs/META.md onBattleStart: "With ev.preview true (no ev.spawns) a handler must NOT change match state or draw match
+// rng". Handlers are content, so the dispatcher enforces it: under a preview every persistent mutator is a dry run that
+// returns what the real call would have returned. 业主 report 2026-10-15 (盟约寄生 banked layers per card opening).
+test('the preview flag makes every persistent mutator a dry run — state, rng and counters all survive', () => {
+  const reg = registerBuiltins(new MetaRegistry(), DATA);
+  const seen = {};
+  reg.global('probe', {
+    onBattleStart: (ctx, ev) => {
+      if (!ev.preview) return;
+      const before = ctx.counter('probe:n');
+      seen.rng = ctx.rng();
+      seen.addFunds = ctx.addFunds(50);
+      seen.spendLp = ctx.spendLp(3);
+      seen.addLayers = ctx.addLayers('yanShip', 7);
+      seen.grantChess = ctx.grantChess(chessOfTier(1)[0]);
+      seen.grantItem = ctx.grantItem('chess_item_1_03_e_a');
+      seen.rollChess = ctx.rollChess({ maxTier: 6 });
+      seen.rollPool = ctx.rollPool('pool_equip_1');
+      seen.setShopSlot = ctx.setShopSlot(0, { kind: 'chess', id: chessOfTier(1)[0] });
+      seen.incCounter = ctx.incCounter('probe:n', 2);
+      seen.counter = ctx.counter('probe:n');
+      seen.triggerGarrisons = ctx.triggerGarrisons(1, 'SERVER_GAIN');
+      seen.destroyPiece = ctx.destroyPiece(1);
+      seen.before = before;
+    },
+  });
+  const { h, m } = metaMatch(reg, { seed: 88 });
+  const ps = h.ps('p_0');
+  const funds = ps.funds;
+  const lp = ps.lp;
+  const layers = { ...ps.layers };
+  const hand = ps.hand.filter(Boolean).length;
+  const rngBefore = m.rngMeta.state(); // the raw state: calling rngMeta() itself would draw
+  const input = ps.battleInput({ side: 'L', colOffset: 0 });
+  m.dispatch(ps, 'onBattleStart', { input, kind: 'normal', round: m.round, preview: true });
+  // the dry runs returned plausible values (so a handler can still patch ev.input with them)
+  assert.equal(seen.addFunds, 0);
+  assert.equal(seen.spendLp, lp);
+  assert.equal(seen.addLayers, 7, 'addLayers reports the gain the real call would have made');
+  assert.equal(seen.grantChess, null);
+  assert.equal(seen.grantItem, null);
+  assert.equal(seen.rollChess, null);
+  assert.equal(seen.rollPool, null);
+  assert.equal(seen.setShopSlot, false);
+  assert.equal(seen.triggerGarrisons, 0);
+  assert.equal(seen.destroyPiece, false);
+  // the shadow counter sees its own write (the preview behaves like the first real run) …
+  assert.equal(seen.before, 0);
+  assert.equal(seen.incCounter, 2);
+  assert.equal(seen.counter, 2);
+  // … and nothing at all reached the match
+  assert.equal(ps.funds, funds, 'funds');
+  assert.equal(ps.lp, lp, 'LP');
+  assert.deepEqual(ps.layers, layers, 'layers');
+  assert.equal(ps.hand.filter(Boolean).length, hand, 'no piece was granted');
+  assert.equal(ps.counters['probe:n'], undefined, 'the shadow counter was never written through');
+  assert.equal(m.rngMeta.state(), rngBefore, 'the match rng stream did not move');
+  h.invariants();
+  m.dispose();
+});
+
